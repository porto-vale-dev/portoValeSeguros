# Copie este arquivo para .env.local para desenvolvimento local.

# Feature flag do widget Blip Chat (balão de chat na home).
# "true" habilita o widget; qualquer outro valor (ou ausência) desabilita.
# Em produção o valor é definido em apphosting.yaml. Ver docs/blip-chat.md.
NEXT_PUBLIC_BLIP_CHAT_ENABLED=false
